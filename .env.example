# CryptoRecon Environment Configuration

# Application Settings
PROJECT_NAME="CryptoRecon"
APP_ENV="development"
DEBUG=True
API_V1_STR="/api/v1"
HOST="0.0.0.0"
PORT=8000

# Redis Cache & Queue
REDIS_URL="redis://localhost:6379/0"
REDIS_ENABLED=True

# Multi-Chain RPC Providers (Public / Private RPC endpoints)
ETH_RPC_URL="https://eth.llamarpc.com"
BSC_RPC_URL="https://binance.llamarpc.com"
POLYGON_RPC_URL="https://polygon.llamarpc.com"
ARBITRUM_RPC_URL="https://arbitrum.llamarpc.com"
OPTIMISM_RPC_URL="https://optimism.llamarpc.com"
TRON_GRID_API_URL="https://api.trongrid.io"
TRON_GRID_API_KEY=""
BITCOIN_RPC_URL="https://blockstream.info/api"

# Bloom Filter & Known Entities
BLOOM_FILTER_EXPECTED_ELEMENTS=150000
BLOOM_FILTER_FALSE_POSITIVE_RATE=0.001

# Forensic Traversal Settings (Phase 2 parameters)
CFR_MIN_ABSOLUTE_FLOW_USDT=50.0
CFR_BRANCH_DILUTION_FACTOR=1.5
MULE_CLUSTER_THRESHOLD_SPLITS=5

# Neo4j Graph Database (Phase 2-4)
NEO4J_URI="bolt://localhost:7687"
NEO4J_USER="neo4j"
NEO4J_PASSWORD="password"
